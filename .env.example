# ============================================
# SmartPothole AI - Environment Configuration
# ============================================
# Copy this file to .env.local (frontend) and .env (ai-service)
# Fill in your actual values

# ============================================
# FRONTEND (Next.js) - Public Variables
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
NEXT_PUBLIC_AI_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# ============================================
# FRONTEND (Next.js) - Server Only Variables
# ============================================
# These should ONLY be set in Vercel/Server environment
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AI_SERVICE_SECRET=your-ai-service-secret-key
INTERNAL_API_SECRET=your-internal-api-secret

# ============================================
# AI SERVICE (FastAPI) - Configuration
# ============================================
# Model Configuration
AI_MODEL_PROVIDER=ultralytics
AI_MODEL_PATH=/app/models/best.pt
AI_MODEL_TYPE=segmentation
AI_MODEL_VERSION=v1.0.0
AI_MODEL_TASK=segment

# Inference Configuration
AI_CONFIDENCE_THRESHOLD=0.25
AI_IOU_THRESHOLD=0.45
AI_IMAGE_SIZE=640
AI_DEVICE=auto
AI_HALF_PRECISION=true

# Performance Profiles
AI_PROFILE_FAST_MODEL=yolo11n-seg.pt
AI_PROFILE_BALANCED_MODEL=yolo11s-seg.pt
AI_PROFILE_ACCURACY_MODEL=yolo11m-seg.pt

# Server Configuration
AI_HOST=0.0.0.0
AI_PORT=8000
AI_WORKERS=1
AI_LOG_LEVEL=info
AI_MAX_UPLOAD_SIZE=104857600
AI_REQUEST_TIMEOUT=300

# Feature Flags
ENABLE_SEGMENTATION=true
ENABLE_TRACKING=true
ENABLE_DEPTH=false
ENABLE_DEMO_MODE=false

# Tracking Configuration
TRACK_MIN_DETECTION_FRAMES=3
TRACK_TIMEOUT=30
TRACK_DEDUPLICATION_DISTANCE=50
TRACK_MIN_CONFIDENCE=0.3

# Severity Configuration
SEVERITY_CONFIG_PATH=/app/config/severity_config.yaml

# CORS
AI_CORS_ORIGINS=http://localhost:3000,https://your-domain.vercel.app

# ============================================
# SUPABASE - Database
# ============================================
# These are set in Supabase dashboard
# SUPABASE_DB_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# ============================================
# OPTIONAL: Redis for Job Queue (Future)
# ============================================
# REDIS_URL=redis://localhost:6379

# ============================================
# OPTIONAL: Sentry Error Tracking
# ============================================
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ============================================
# OPTIONAL: Analytics
# ============================================
# NEXT_PUBLIC_GA_ID=